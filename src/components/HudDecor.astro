---
// Above-footer ornament: original anime-style mech bust silhouette + HUD
// readout strip. Replaces the earlier twin-radar circles to bring the
// mech-anime half of the aesthetic forward. Pure linework, no fills —
// inherits stroke colour from CSS via `currentColor`.
---
<aside class="hud-decor" aria-hidden="true">
  <svg viewBox="0 0 240 120" xmlns="http://www.w3.org/2000/svg">
    {/* Mech bust on the left, ~70px wide */}
    <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" transform="translate(8 8)">
      {/* Head crest */}
      <path d="M30 4 L46 4 L50 12 L50 22 L42 30 L34 30 L26 22 L26 12 Z" />
      {/* Visor — two slit eyes */}
      <line x1="30" y1="16" x2="36" y2="16" stroke-width="2" />
      <line x1="40" y1="16" x2="46" y2="16" stroke-width="2" />
      {/* Antenna */}
      <line x1="38" y1="0" x2="38" y2="4" />
      {/* Neck */}
      <path d="M34 30 L34 34 L42 34 L42 30" />
      {/* Shoulders */}
      <path d="M14 38 L30 36 L46 36 L62 38 L62 50 L46 50 L46 44 L30 44 L30 50 L14 50 Z" />
      {/* Chest core */}
      <rect x="32" y="44" width="12" height="12" />
      <line x1="38" y1="46" x2="38" y2="54" />
      {/* Lower torso hint */}
      <path d="M22 56 L54 56 L50 70 L26 70 Z" />
    </g>

    {/* Readout strip on the right */}
    <g fill="currentColor" font-family="ui-monospace, monospace" font-size="6.5" letter-spacing="0.6" transform="translate(96 22)">
      <text x="0" y="0">UNIT</text><text x="80" y="0" text-anchor="end">M9-GERNSBACK</text>
      <text x="0" y="14">PILOT</text><text x="80" y="14" text-anchor="end">SOUSUKE.S</text>
      <text x="0" y="28">POWER</text><text x="80" y="28" text-anchor="end">100%</text>
      <text x="0" y="42">STATUS</text><text x="80" y="42" text-anchor="end">STANDBY</text>
      <text x="0" y="56">SECTOR</text><text x="80" y="56" text-anchor="end">04 / NOTES</text>
    </g>
    {/* Frame line under readout */}
    <line x1="96" y1="92" x2="232" y2="92" stroke="currentColor" />
    <text x="232" y="102" fill="currentColor" font-family="ui-monospace, monospace" font-size="5.5" letter-spacing="0.5" text-anchor="end">// Affirmative.</text>
  </svg>
</aside>
