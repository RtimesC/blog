---
// Magnetic pull: interactive elements drift slightly toward the cursor.
// A tiny client-side "island" — re-binds on every page load so it survives
// view-transition DOM swaps, and stays off under reduced-motion.
// Elements opt in by being matched here; CSS reads the --mx / --my it sets.
---
<script>
  const MAX = 6; // px — pull is capped and size-independent (no edge jitter)
  const SELECTOR = '.post-list li, .site-header nav a, .theme-toggle';
  const clamp = (n: number) => Math.max(-1, Math.min(1, n));

  function bind() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>(SELECTOR).forEach((el) => {
      if (el.dataset.magnetic) return;
      el.dataset.magnetic = '1';
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        // Normalise by half-size so a wide card pulls the same tiny amount as a
        // small link, then cap at MAX — this is what kills the edge jitter.
        const mx = clamp((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * MAX;
        const my = clamp((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * MAX;
        el.style.setProperty('--mx', `${mx.toFixed(1)}px`);
        el.style.setProperty('--my', `${my.toFixed(1)}px`);
      });
      el.addEventListener('pointerleave', () => {
        el.style.removeProperty('--mx');
        el.style.removeProperty('--my');
      });
    });
  }

  document.addEventListener('astro:page-load', bind);
</script>
