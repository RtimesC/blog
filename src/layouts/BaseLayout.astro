---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import MermaidClient from '../components/MermaidClient.astro';
import Ripple from '../components/Ripple.astro';
import Magnetic from '../components/Magnetic.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'Sousuke';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} · notes`;

// Which segment of the pill nav is "selected" for this page. The active
// segment carries the sliding thumb; ClientRouter animates it between pages.
const path = Astro.url.pathname;
const section =
  path === '/' || path.startsWith('/posts')
    ? 'posts'
    : path.startsWith('/categories')
      ? 'topics'
      : path.startsWith('/about')
        ? 'about'
        : '';
const navItems = [
  { href: '/', label: 'Posts', key: 'posts' },
  { href: '/categories/', label: 'Topics', key: 'topics' },
  { href: '/about/', label: 'About', key: 'about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    {/* Apply saved theme before paint, and re-apply after each view transition. */}
    <script is:inline>
      (function () {
        const apply = () => {
          try {
            const stored = localStorage.getItem('theme');
            const theme =
              stored ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light');
            document.documentElement.dataset.theme = theme;
          } catch (e) {
            document.documentElement.dataset.theme = 'light';
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    {/* Liquid-glass refraction filter for the nav pill. Keep the displacement
        subtle: the edge highlights do most of the work, while the backdrop only
        bends a few pixels so grids do not look wavy. */}
    <svg class="glass-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="glass-refract" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.018 0.022" numOctaves="1" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="0.8" result="soft" />
        <feDisplacementMap in="SourceGraphic" in2="soft" scale="6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="site-header">
      <nav class="nav-pill" aria-label="Primary" data-active-section={section}>
        <span class="nav-thumb" aria-hidden="true"></span>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={['segment', { 'is-active': section === item.key }]}
              data-nav-key={item.key}
              aria-current={section === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <span class="nav-sep" aria-hidden="true"></span>
        <a
          class="pill-icon"
          href="https://github.com/RtimesC"
          target="_blank"
          rel="me noopener"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
        <ThemeToggle />
      </nav>
    </header>

    <div class="wrap">
      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Sousuke · robotics, SLAM, embedded, FPV, deep learning.</p>
      </footer>
    </div>

    <MermaidClient />
    <Ripple />
    <Magnetic />
    <script is:inline>
      (() => {
        const bindNavThumb = () => {
          const header = document.querySelector('.site-header');
          const nav = document.querySelector('.nav-pill');
          if (!header || !nav) return;

          window.__navThumbAbort?.abort();
          window.__navThumbAbort = new AbortController();
          const { signal } = window.__navThumbAbort;
          const segments = [...nav.querySelectorAll('.segment')];
          const active = () =>
            nav.querySelector('.segment[aria-current="page"]') || segments[0];
          let lastThumbBox = '';

          const moveThumb = (target, options = {}) => {
            if (!target) return;
            const navRect = nav.getBoundingClientRect();
            const rect = target.getBoundingClientRect();
            const box = {
              x: Math.round((rect.left - navRect.left) * 10) / 10,
              y: Math.round((rect.top - navRect.top) * 10) / 10,
              w: Math.round(rect.width * 10) / 10,
              h: Math.round(rect.height * 10) / 10,
            };
            const boxKey = `${box.x}:${box.y}:${box.w}:${box.h}`;
            if (boxKey === lastThumbBox) return;

            nav.classList.toggle('is-thumb-instant', Boolean(options.instant));
            nav.style.setProperty('--thumb-x', `${box.x}px`);
            nav.style.setProperty('--thumb-y', `${box.y}px`);
            nav.style.setProperty('--thumb-w', `${box.w}px`);
            nav.style.setProperty('--thumb-h', `${box.h}px`);
            nav.classList.add('is-thumb-ready');
            lastThumbBox = boxKey;

            if (options.instant) {
              window.requestAnimationFrame(() => nav.classList.remove('is-thumb-instant'));
            }
          };

          moveThumb(active(), { instant: true });

          const showNav = () => header.classList.remove('is-nav-hidden');
          const hideNav = () => {
            const navHasFocus = nav.contains(document.activeElement);
            if (window.scrollY > 96 && !nav.matches(':hover') && !navHasFocus) {
              header.classList.add('is-nav-hidden');
            }
          };

          let lastScrollY = window.scrollY;
          let scrollFrame = 0;
          const syncNavVisibility = () => {
            scrollFrame = 0;
            const currentY = window.scrollY;
            const delta = currentY - lastScrollY;

            if (currentY <= 8) {
              showNav();
            } else if (delta > 6 && currentY > 120) {
              hideNav();
            } else if (delta < -4) {
              showNav();
            }

            lastScrollY = currentY;
          };

          const requestVisibilitySync = () => {
            if (!scrollFrame) scrollFrame = window.requestAnimationFrame(syncNavVisibility);
          };

          segments.forEach((segment) => {
            segment.addEventListener('pointerenter', () => {
              showNav();
              moveThumb(segment);
            }, { signal });
            segment.addEventListener('mouseenter', () => {
              showNav();
              moveThumb(segment);
            }, { signal });
            segment.addEventListener('pointerdown', () => {
              nav.classList.add('is-thumb-pressed');
              showNav();
              moveThumb(segment);
            }, { signal });
            segment.addEventListener('click', () => {
              window.setTimeout(() => nav.classList.remove('is-thumb-pressed'), 220);
            }, { signal });
            segment.addEventListener('focus', () => {
              showNav();
              moveThumb(segment);
            }, { signal });
          });

          nav.addEventListener('pointerleave', () => {
            moveThumb(active());
            if (window.scrollY > 120) hideNav();
          }, { signal });
          nav.addEventListener('focusin', showNav, { signal });
          nav.addEventListener('focusout', (event) => {
            if (!nav.contains(event.relatedTarget)) moveThumb(active());
          }, { signal });
          window.addEventListener('scroll', requestVisibilitySync, { passive: true, signal });
          window.addEventListener('pointermove', (event) => {
            if (event.clientY < 88) showNav();
          }, { passive: true, signal });
          window.addEventListener('resize', () => {
            moveThumb(active());
            requestVisibilitySync();
          }, { passive: true, signal });
          syncNavVisibility();
        };

        bindNavThumb();
        document.addEventListener('astro:page-load', bindNavThumb);
        document.addEventListener('astro:after-swap', bindNavThumb);
      })();
    </script>
  </body>
</html>
